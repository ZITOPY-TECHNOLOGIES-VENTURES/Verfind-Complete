{
  "name": "verifind-api",
  "version": "2.0.0",
  "description": "Verifind Real Estate — Express + Postgres (Prisma) API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "npx prisma migrate deploy && node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:legacy": "node test-fixes.js && node test-v2.js",
    "build": "npm install --prefix ../frontend --include=dev && npm run build --prefix ../frontend && npx prisma generate",
    "migrate": "prisma migrate deploy"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0"
  }
}
